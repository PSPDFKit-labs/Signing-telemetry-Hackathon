{
  "name": "nutrient-sign",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "22.x",
    "pnpm": "10.x"
  },
  "packageManager": "pnpm@10.28.0",
  "pnpm": {
    "overrides": {
      "browserslist": ">=4.28.7"
    }
  },
  "scripts": {
    "readiness": "node scripts/readiness.mjs",
    "local:setup": "docker compose -f compose.local.yml up -d --wait && node scripts/local-setup.mjs && pnpm db:migrate",
    "local:start": "next dev --webpack --hostname 127.0.0.1 --port 3000",
    "local:stop": "docker compose -f compose.local.yml stop",
    "dev": "next dev --turbopack",
    "prebuild": "zero-icons",
    "build": "next build",
    "start": "node scripts/verify-local-runtime.mjs && docker compose -f compose.local.yml up -d --wait && node scripts/local-setup.mjs && drizzle-kit migrate --config=database/drizzle/drizzle.config.ts && next build && node scripts/start-local-demo.mjs",
    "local:smoke": "node scripts/local-smoke.mjs",
    "serve": "next start --hostname 127.0.0.1 --port 3000",
    "lint": "biome check .",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "biome:check": "biome check .",
    "biome:fix": "biome check --write .",
    "biome:format": "biome format --write .",
    "db:generate": "drizzle-kit generate --config=database/drizzle/drizzle.config.ts",
    "db:migrate": "drizzle-kit migrate --config=database/drizzle/drizzle.config.ts",
    "db:export": "drizzle-kit export --config=database/drizzle/drizzle.config.ts",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@auth/drizzle-adapter": "^1.11.3",
    "@aws-sdk/client-s3": "^3.1135.0",
    "@aws-sdk/s3-request-presigner": "^3.1135.0",
    "@neondatabase/serverless": "^1.1.0",
    "@nutrient-sdk/viewer": "^1.22.0",
    "@radix-ui/react-alert-dialog": "^1.1.23",
    "@radix-ui/react-checkbox": "^1.3.11",
    "@radix-ui/react-collapsible": "^1.1.20",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-progress": "^1.1.16",
    "@radix-ui/react-radio-group": "^1.4.7",
    "@radix-ui/react-scroll-area": "^1.2.18",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-separator": "^1.1.15",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-toast": "^1.2.23",
    "@radix-ui/react-toggle": "^1.1.18",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@react-zero-ui/core": "^0.4.3",
    "@react-zero-ui/icon-sprite": "^0.4.1",
    "@upstash/ratelimit": "^2.1.0",
    "@upstash/redis": "^1.38.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "4.4.0",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "next": "16.3.5",
    "next-auth": "5.0.0-beta.32",
    "nodemailer": "^8.0.11",
    "pdf-lib": "^1.17.1",
    "pg": "^8.23.0",
    "postgres": "^3.4.9",
    "react": "^19.3.0",
    "react-datepicker": "^9.1.0",
    "react-dom": "^19.3.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tailwindcss-animate": "^1.0.7",
    "uuid": "^14.0.2"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.1",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.6.1",
    "drizzle-kit": "^0.31.10",
    "postcss": "^8.5.28",
    "prettier": "^3.9.8",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.13",
    "typescript": "^6.0.3",
    "vitest": "^5.0.1"
  }
}
