{
  "compilerOptions": {
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "target": "ES6",
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./*"],
      "@zero-ui/attributes": ["./.zero-ui/attributes.js"]
    },
    "ignoreDeprecations": "6.0"
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".next/**/*.d.ts",
    ".next/dev/types/**/*.ts",
    ".next/types/**/*.ts",
    ".zero-ui/**/*.d.ts",
    "components/enhanced-theme-toggle-simple.tsx.st",
    "components/layout.tsx",
    "lib/schema.prisma",
    "next-env.d.ts"
  ],
  "exclude": ["node_modules"]
}
